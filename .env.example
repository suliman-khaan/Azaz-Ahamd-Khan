# ==========================================
# Azaz & Associates LLP - Vercel Environment Variables
# Add these in Vercel Dashboard > Project Settings > Environment Variables
# ==========================================

# Your Gmail / Google Workspace address used to send the emails
GMAIL_USER=tax@azazassociatesllp.com

# 16-character Google App Password (NOT your normal Gmail login password)
# How to get it:
# 1. Go to Google Account (myaccount.google.com)
# 2. Select "Security" > Enable "2-Step Verification"
# 3. Search for "App Passwords"
# 4. Create an App Password (Name: "Azaz Website Vercel")
# 5. Copy the 16-character code (e.g. abcd efgh ijkl mnop) and paste below:
GMAIL_PASS=your_16_character_app_password

# Chambers inbox to receive new consultation inquiries
NOTIFICATION_RECEIVER=tax@azazassociatesllp.com
